# Copiá este archivo como  .env.local  y completá con los datos de tu proyecto Supabase.
# (En Supabase: Project Settings -> API)
# Estas dos claves son PUBLICAS (van al navegador). La anon key es segura de exponer
# porque el acceso real lo controlan las politicas RLS de la base.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
